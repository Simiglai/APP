{"mailer_subjects_confirmation": "{{ if eq .Data.language \"da\" }}Bekræft din konto{{ else }}Confirm your account{{ end }} — Patrick Simiglai", "mailer_templates_confirmation_content": "{{ if eq .Data.language \"da\" }}<div style=\"background:#ececec;padding:32px 16px;font-family:Montserrat,Helvetica,Arial,sans-serif\">\n<div style=\"max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden\">\n<div style=\"background:#12264a;padding:28px 32px\"><img src=\"https://app.patricksimiglai.com/brand/logo-white.png\" alt=\"Patrick Simiglai\" width=\"96\" style=\"display:block;height:auto\"></div>\n<div style=\"padding:32px;color:#313132\">\n<h1 style=\"margin:0 0 12px;color:#12264a;font-size:22px\">Velkommen!</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:1.6\">Bekræft din e-mail for at komme i gang med dine daglige check-ins og din accountability med Patrick.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#12264a;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 24px;border-radius:12px\">Bekræft min konto</a>\n<p style=\"margin:24px 0 0;font-size:12px;color:#6b6b6e\">Hvis du ikke har bedt om denne e-mail, kan du roligt ignorere den.</p>\n</div></div></div>{{ else }}<div style=\"background:#ececec;padding:32px 16px;font-family:Montserrat,Helvetica,Arial,sans-serif\">\n<div style=\"max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden\">\n<div style=\"background:#12264a;padding:28px 32px\"><img src=\"https://app.patricksimiglai.com/brand/logo-white.png\" alt=\"Patrick Simiglai\" width=\"96\" style=\"display:block;height:auto\"></div>\n<div style=\"padding:32px;color:#313132\">\n<h1 style=\"margin:0 0 12px;color:#12264a;font-size:22px\">Welcome!</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:1.6\">Confirm your email to get started with your daily check-ins and accountability with Patrick.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#12264a;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 24px;border-radius:12px\">Confirm my account</a>\n<p style=\"margin:24px 0 0;font-size:12px;color:#6b6b6e\">If you didn’t ask for this email, you can safely ignore it.</p>\n</div></div></div>{{ end }}", "mailer_subjects_recovery": "{{ if eq .Data.language \"da\" }}Nulstil din adgangskode{{ else }}Reset your password{{ end }} — Patrick Simiglai", "mailer_templates_recovery_content": "{{ if eq .Data.language \"da\" }}<div style=\"background:#ececec;padding:32px 16px;font-family:Montserrat,Helvetica,Arial,sans-serif\">\n<div style=\"max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden\">\n<div style=\"background:#12264a;padding:28px 32px\"><img src=\"https://app.patricksimiglai.com/brand/logo-white.png\" alt=\"Patrick Simiglai\" width=\"96\" style=\"display:block;height:auto\"></div>\n<div style=\"padding:32px;color:#313132\">\n<h1 style=\"margin:0 0 12px;color:#12264a;font-size:22px\">Nulstil din adgangskode</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:1.6\">Tryk på knappen for at vælge en ny adgangskode.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#12264a;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 24px;border-radius:12px\">Vælg ny adgangskode</a>\n<p style=\"margin:24px 0 0;font-size:12px;color:#6b6b6e\">Hvis du ikke har bedt om denne e-mail, kan du roligt ignorere den.</p>\n</div></div></div>{{ else }}<div style=\"background:#ececec;padding:32px 16px;font-family:Montserrat,Helvetica,Arial,sans-serif\">\n<div style=\"max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden\">\n<div style=\"background:#12264a;padding:28px 32px\"><img src=\"https://app.patricksimiglai.com/brand/logo-white.png\" alt=\"Patrick Simiglai\" width=\"96\" style=\"display:block;height:auto\"></div>\n<div style=\"padding:32px;color:#313132\">\n<h1 style=\"margin:0 0 12px;color:#12264a;font-size:22px\">Reset your password</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:1.6\">Tap the button to choose a new password.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#12264a;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 24px;border-radius:12px\">Choose a new password</a>\n<p style=\"margin:24px 0 0;font-size:12px;color:#6b6b6e\">If you didn’t ask for this email, you can safely ignore it.</p>\n</div></div></div>{{ end }}", "mailer_subjects_email_change": "{{ if eq .Data.language \"da\" }}Bekræft din nye e-mail{{ else }}Confirm your new email{{ end }} — Patrick Simiglai", "mailer_templates_email_change_content": "{{ if eq .Data.language \"da\" }}<div style=\"background:#ececec;padding:32px 16px;font-family:Montserrat,Helvetica,Arial,sans-serif\">\n<div style=\"max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden\">\n<div style=\"background:#12264a;padding:28px 32px\"><img src=\"https://app.patricksimiglai.com/brand/logo-white.png\" alt=\"Patrick Simiglai\" width=\"96\" style=\"display:block;height:auto\"></div>\n<div style=\"padding:32px;color:#313132\">\n<h1 style=\"margin:0 0 12px;color:#12264a;font-size:22px\">Bekræft din nye e-mail</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:1.6\">Tryk på knappen for at bekræfte din nye e-mailadresse.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#12264a;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 24px;border-radius:12px\">Bekræft e-mail</a>\n<p style=\"margin:24px 0 0;font-size:12px;color:#6b6b6e\">Hvis du ikke har bedt om denne e-mail, kan du roligt ignorere den.</p>\n</div></div></div>{{ else }}<div style=\"background:#ececec;padding:32px 16px;font-family:Montserrat,Helvetica,Arial,sans-serif\">\n<div style=\"max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden\">\n<div style=\"background:#12264a;padding:28px 32px\"><img src=\"https://app.patricksimiglai.com/brand/logo-white.png\" alt=\"Patrick Simiglai\" width=\"96\" style=\"display:block;height:auto\"></div>\n<div style=\"padding:32px;color:#313132\">\n<h1 style=\"margin:0 0 12px;color:#12264a;font-size:22px\">Confirm your new email</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:1.6\">Tap the button to confirm your new email address.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#12264a;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 24px;border-radius:12px\">Confirm email</a>\n<p style=\"margin:24px 0 0;font-size:12px;color:#6b6b6e\">If you didn’t ask for this email, you can safely ignore it.</p>\n</div></div></div>{{ end }}"}